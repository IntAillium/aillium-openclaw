# OpenClaw .env example
#
# Quick start:
# 1) Copy this file to `.env` (for local runs from this repo), OR to `~/.openclaw/.env` (for launchd/systemd daemons).
# 2) Fill only the values you use.
# 3) Keep real secrets out of git.
#
# Env-source precedence for environment variables (highest -> lowest):
# process env, ./.env, ~/.openclaw/.env, then openclaw.json `env` block.
# Existing non-empty process env vars are not overridden by dotenv/config env loading.
# Note: direct config keys (for example `gateway.auth.token` or channel tokens in openclaw.json)
# are resolved separately from env loading and often take precedence over env fallbacks.

# -----------------------------------------------------------------------------
# Gateway auth + paths
# -----------------------------------------------------------------------------
# Recommended if the gateway binds beyond loopback.
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token
# Example generator: openssl rand -hex 32

# Optional alternative auth mode (use token OR password).
# OPENCLAW_GATEWAY_PASSWORD=change-me-to-a-strong-password

# Optional path overrides (defaults shown for reference).
# OPENCLAW_STATE_DIR=~/.openclaw
# OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json
# OPENCLAW_HOME=~

# Optional: import missing keys from your login shell profile.
# OPENCLAW_LOAD_SHELL_ENV=1
# OPENCLAW_SHELL_ENV_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Model provider API keys (set at least one)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# OPENCLAW_LIVE_OPENAI_KEY=sk-...
# OPENCLAW_LIVE_ANTHROPIC_KEY=sk-ant-...
# OPENCLAW_LIVE_GEMINI_KEY=...
# OPENAI_API_KEY_1=...
# ANTHROPIC_API_KEY_1=...
# GEMINI_API_KEY_1=...
# GOOGLE_API_KEY=...
# OPENAI_API_KEYS=sk-1,sk-2
# ANTHROPIC_API_KEYS=sk-ant-1,sk-ant-2
# GEMINI_API_KEYS=key-1,key-2

# Optional additional providers
# ZAI_API_KEY=...
# AI_GATEWAY_API_KEY=...
# MINIMAX_API_KEY=...
# SYNTHETIC_API_KEY=...

# -----------------------------------------------------------------------------
# Channels (only set what you enable)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Optional channel env fallbacks
# MATTERMOST_BOT_TOKEN=...
# MATTERMOST_URL=https://chat.example.com
# ZALO_BOT_TOKEN=...
# OPENCLAW_TWITCH_ACCESS_TOKEN=oauth:...

# -----------------------------------------------------------------------------
# Tools + voice/media (optional)
# -----------------------------------------------------------------------------
# BRAVE_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
# FIRECRAWL_API_KEY=...

# ELEVENLABS_API_KEY=...
# XI_API_KEY=...  # alias for ElevenLabs
# DEEPGRAM_API_KEY=...

# -----------------------------------------------------------------------------
# Aillium Core integration (optional)
# -----------------------------------------------------------------------------
# Connects this operator runtime to the Aillium Core control plane so runtime
# state, evidence, context-lifecycle events, and Staff Room memory flow through
# the src/aillium boundary. When unset, the runtime uses no-op default adapters
# and behaves exactly like upstream OpenClaw.
#
# Base URL of Aillium Core (routes are mounted at root, no /api prefix):
# AILLIUM_CORE_URL=http://aillium-core:3000
# Runtime sync token; must match one of Core's accepted tokens
# (OPERATOR_RUNTIME_TOKEN / MASTER_AGENT_RUNTIME_SYNC_TOKEN):
# AILLIUM_RUNTIME_TOKEN=change-me
# Tenant this runtime belongs to. Core binds the runtime to this tenant's
# enabled master-agent profile on registration (POST .../runtime/register):
# AILLIUM_TENANT_ID=
# Existing session key to reactivate instead of creating a new session
# (optional; Core generates one at registration when omitted):
# AILLIUM_RUNTIME_SESSION_KEY=
# Aillium agent identity this runtime acts as. When set, the agent's Staff Room
# context is injected into its system prompt (cached ~5 min):
# AILLIUM_AGENT_ID=
# Optional request timeout for Core calls (ms, default 15000):
# AILLIUM_RUNTIME_TIMEOUT_MS=15000

# Portal origin for CORS on Aillium proxy endpoints:
# AILLIUM_PORTAL_ORIGIN=https://portal.example.com

# Optional dedicated token for the Aillium MCP HTTP adapter. When unset, the
# adapter falls back to the canonical runtime token above:
# AILLIUM_MCP_RUNTIME_TOKEN=

# UI-TARS Desktop RPC bridge URL (the second name is a compatibility alias):
# AILLIUM_DESKTOP_BRIDGE_URL=http://localhost:24000
# AILLIUM_UI_TARS_DESKTOP_RPC_URL=http://localhost:24000

# Desktop operator launch URL (the second name is a compatibility alias):
# AILLIUM_OPERATOR_DESKTOP_URL=
# AILLIUM_DESKTOP_LAUNCH_URL=

# Optional dedicated Desktop bridge token. When unset, the bridge falls back to
# the canonical runtime token above:
# AILLIUM_DESKTOP_BRIDGE_TOKEN=
